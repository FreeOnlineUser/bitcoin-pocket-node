<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP everywhere. Justified:
         - localhost RPC to bitcoind
         - LAN sharing (phone-to-phone, relay)
         - Tor .onion (Tor provides encryption)
         No sensitive data sent over clearnet HTTP. All external
         API calls (mempool.space, RGS) use HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
